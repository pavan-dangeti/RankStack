# Copy to .env and fill in. .env is gitignored and must never be committed.
# These keys are optional: no part of retrieval, ranking, serving or the demo depends on them.
# They are used only for offline analysis, and only with aggregate numbers or repository-authored
# text, never with dataset content (see docs/adr/0004-local-text-embeddings.md).

# https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: enables the distributed online-feature-store integration test
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=